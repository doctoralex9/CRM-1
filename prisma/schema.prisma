// =============================================================================
// CRM Ship Pump Repair - Prisma Schema
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum CustomerType {
  company
  individual
}

enum OfferStatus {
  draft
  sent
  accepted
  rejected
  expired
}

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

model Customer {
  id           String       @id @default(cuid())
  customerType CustomerType @map("customer_type")

  // Company fields
  companyName String? @map("company_name")

  // Individual fields
  firstName String? @map("first_name")
  lastName  String? @map("last_name")

  // Tax info
  vatNumber String? @unique @map("vat_number")
  taxOffice String? @map("tax_office")

  // Contact info
  phone      String?
  email      String?
  address    String?
  city       String?
  postalCode String? @map("postal_code")

  // Notes
  notes String?

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  offers Offer[]

  @@index([customerType])
  @@index([companyName])
  @@index([lastName])
  @@index([createdAt(sort: Desc)])
  @@map("customers")
}

model Offer {
  id          String      @id @default(cuid())
  offerNumber String      @unique @map("offer_number")
  customerId  String      @map("customer_id")
  title       String
  objectDescription String? @map("object_description")
  workReport  String?     @map("work_report")
  status      OfferStatus @default(draft)

  // Amounts
  subtotal  Decimal @default(0) @db.Decimal(12, 2)
  vatRate   Decimal @default(24) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount Decimal @default(0) @map("vat_amount") @db.Decimal(12, 2)
  total     Decimal @default(0) @db.Decimal(12, 2)

  // Terms
  termsText String? @map("terms_text")

  // Dates
  offerDate  DateTime  @default(now()) @map("offer_date") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customer        Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lineItems       OfferLineItem[]
  selectedClauses OfferSelectedClause[]

  @@index([customerId])
  @@index([status])
  @@index([offerDate(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([customerId, status])
  @@map("offers")
}

model OfferLineItem {
  id              String  @id @default(cuid())
  offerId         String  @map("offer_id")
  sortOrder       Int     @default(0) @map("sort_order")
  description     String
  quantity        Decimal @default(1) @db.Decimal(10, 2)
  unit            String  @default("τεμ.")
  unitPrice       Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  lineTotal       Decimal @default(0) @map("line_total") @db.Decimal(12, 2)

  // Timestamp
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([offerId, sortOrder])
  @@map("offer_line_items")
}

model TermsClauseTemplate {
  id         String  @id @default(cuid())
  title      String
  clauseText String  @map("clause_text")
  sortOrder  Int     @default(0) @map("sort_order")
  isActive   Boolean @default(true) @map("is_active")
  isDefault  Boolean @default(false) @map("is_default")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  selectedInOffers OfferSelectedClause[]

  @@index([sortOrder])
  @@map("terms_clause_templates")
}

model OfferSelectedClause {
  id                 String @id @default(cuid())
  offerId            String @map("offer_id")
  clauseTemplateId   String @map("clause_template_id")
  sortOrder          Int    @default(0) @map("sort_order")
  clauseTextSnapshot String @map("clause_text_snapshot")

  // Relations
  offer          Offer               @relation(fields: [offerId], references: [id], onDelete: Cascade)
  clauseTemplate TermsClauseTemplate @relation(fields: [clauseTemplateId], references: [id], onDelete: Restrict)

  @@unique([offerId, clauseTemplateId])
  @@index([offerId])
  @@map("offer_selected_clauses")
}

model OfferNumberSequence {
  year       Int @id
  lastNumber Int @default(0) @map("last_number")

  @@map("offer_number_sequence")
}

// -----------------------------------------------------------------------------
// App Settings (for company info, etc.)
// -----------------------------------------------------------------------------

model AppSettings {
  id    String @id @default("default")
  key   String @unique
  value String

  @@map("app_settings")
}
