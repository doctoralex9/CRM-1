# =============================================================================
# CRM Ship Pump Repair - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
# Get these from: Supabase Dashboard > Project Settings > Database
#
# DATABASE_URL: Connection pooler (for Prisma queries)
# DIRECT_URL: Direct connection (for migrations)

DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Get your API key from: https://resend.com/api-keys

RESEND_API_KEY="re_xxxxxxxxxxxx"

# The email address that will appear as "from" in sent emails
EMAIL_FROM="noreply@yourdomain.com"

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------

# Base URL of your app (used for links in emails, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Company Information (Placeholders - Update with real values)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_COMPANY_NAME="[Όνομα Εταιρείας]"
NEXT_PUBLIC_COMPANY_ADDRESS="[Διεύθυνση]"
NEXT_PUBLIC_COMPANY_CITY="[Πόλη]"
NEXT_PUBLIC_COMPANY_POSTAL="[Τ.Κ.]"
NEXT_PUBLIC_COMPANY_PHONE="[Τηλέφωνο]"
NEXT_PUBLIC_COMPANY_EMAIL="[Email]"
NEXT_PUBLIC_COMPANY_VAT="[ΑΦΜ]"
NEXT_PUBLIC_COMPANY_TAX_OFFICE="[ΔΟΥ]"
